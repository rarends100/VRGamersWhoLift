    //Tag helpers to generate URLs pg 246
    //Access model props in a view pg 258

    ViewData["Title"] = "Profile Page";

}


<!DOCTYPE html>
<html>
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Profile Page</title>
    </head>
    <body>
    <div>
        <img src="profile_photo" alt="profile_photo" name="profile_photo" id="profile_photo"/>
    </div>
        <h1>Welcome [Name]</h1>
        <p>Profile page</p>
        <div class="photo_chooser_box hidden" id="profile_photo_chooser">
            <partial name="~/Views/Shared/_uploadImage.cshtml" /> <!--https://learn.microsoft.com/en-us/aspnet/core/mvc/views/partial?view=aspnetcore-10.0-->
        <span style="color: red; margin-left: 100px; background-color: black;">@if (ViewBag.Errors != null && ViewBag.Errors.Count != 0 )
            { 
                foreach (string error in ViewBag.Errors) { @error; } 
            }</span>
    </div>
