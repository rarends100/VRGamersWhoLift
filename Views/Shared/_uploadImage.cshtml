<div id="photo_chooser">
    <form asp-controller="Profile" asp-action="ProfilePhotoUpdate" enctype="multipart/form-data">
        <label for="Image">Choose an image to upload</label>
        <input type="file" id="image" name="image" accept="/image/png,image/jpeg,image/jpg,image/webp" />

        <input type="submit" value="Update Profile Photo" />
    </form>
    
</div>

