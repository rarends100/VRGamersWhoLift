@using Microsoft.AspNetCore.Identity
@using VRGamersWhoLift.Models.Abstract

@inject SignInManager<User> signInManager

<!--ATTENTION: Model that plugs into this must be ProfileViewModel-->
<div id="posts" class="post_shell">
    <div class="post_text_display ms-sm-1">
        <p>
            @if (Model.posts != null)
            {
                foreach (Post post in Model.posts)
                {
                    <div class="post_container">
                        @post.PostText
                    </div>

                    <div class="post_button_row">
                        <div class="post_three_col_buttons">
                            <input type="button" value="comment" id="open_post_for_commenting_toggle" class="button_style" /><!--1. TODO: write Javascript that toggles open the div for the comment partial view to display. Then write code to submit the comment changes to the soon to be existent comment controller-->
                            <div id="add_comment">

                            </div>
                            <div>
                                <!--Holds the _comment_display partial view-->

                            </div>
                        </div>
                        <div class="post_three_col_buttons">
                            @if (signInManager.IsSignedIn(User))
                            {
                                <input type="button" id="toggle_post_edit_form_button" value="edit" class="button_style" />
                                <div class="hidden pop_box" id="edit_post">
                                    <input type="button" value="X" class="button_style" id="exit_edit_post_button" />
                                    <form asp-controller="Post" asp-action="UpdatePost" method="post">
                                        <input type="hidden" value="@post.PostId" name="PostId" />

                                        <textarea 
                                            name="new_post_text"
                                            cols="50"
                                            rows="5"
                                            >What's on your mind?</textarea>
                                        <input type="submit" value="save" class="button_style" />
                                        <div>
                                            <p>Current Post:<br /></p>
                                            <p>@post.PostText</p>
                                        </div>
                                    </form>
                                   
                                </div>
                                
                            }
                        </div>
                        <div class="post_three_col_buttons">
                            @if (signInManager.IsSignedIn(User))
                            {
                                <form asp-controller="Post" asp-action="DeletePost" method="post">
                                    <input type="hidden" value="@post.PostId" name="PostId"/>
                                    <input type="submit" value="delete" class="button_style" />
                                </form>
                            }
                        </div>
                    </div>
                } 
                
            }
            else
            {
                <div class="post_container">
                    no posts
                </div>
            }
        </p>
        <!--2. TODO: After the comment can be added, make it so that the comments display here on a post, make it so that the comments can be show/hidden/toggled-->
           
       
    </div>
</div>