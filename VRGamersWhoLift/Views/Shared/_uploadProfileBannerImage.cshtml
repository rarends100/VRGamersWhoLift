<div id="photo_chooser">
    <form asp-controller="Profile" asp-action="ProfileBannerUpdate" enctype="multipart/form-data">
        <label for="Image">Choose an image to for your banner.</label>
        <input type="file" id="image" name="image" accept="/image/png,image/jpeg,image/jpg,image/webp" />

        <input type="submit" value="Update Profile Banner" style="margin-left: 350px; margin-top: 20px; margin-bottom: 5px;" />
    </form>
    
</div>

